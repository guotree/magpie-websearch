{
  "name": "@guotree/magpie-websearch",
  "version": "0.7.0",
  "description": "Web search APIs for magpie: 21 REST and MCP providers including Zhipu and Z.ai Standard API and Coding Plan search. Keys are managed by magpie.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "assets",
    "docs",
    "README.md",
    "README.en.md",
    "PROVIDERS.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "websearch",
    "search",
    "anysearch",
    "bocha",
    "jina",
    "kagi",
    "keenable",
    "linkup",
    "metaso",
    "moonshot",
    "moonshot-cn",
    "kimi",
    "ollama",
    "parallel",
    "perplexity",
    "querit",
    "serpapi",
    "serper",
    "stepfun",
    "tinyfish",
    "zai",
    "zai-coding",
    "zhipu",
    "zhipu-coding"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guotree/magpie-websearch.git"
  },
  "homepage": "https://github.com/guotree/magpie-websearch#readme",
  "bugs": {
    "url": "https://github.com/guotree/magpie-websearch/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "magpie": {
    "name": "magpie-websearch",
    "icon": "https://raw.githubusercontent.com/guotree/magpie-websearch/main/assets/icon-128.png"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs && npm test",
    "check:bun": "bun scripts/check.mjs && bun scripts/test.mjs",
    "smoke:magpie": "node scripts/smoke-magpie.mjs"
  }
}
